# mock — фронт работает на встроенных демо-данных, бэкенд не нужен.
# api  — запросы идут в Django REST Framework.
NEXT_PUBLIC_API_MODE=mock

# Адрес бэкенда без /api/v1 на конце.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Откуда грузятся картинки товаров, если это не тот же хост, что API (S3, Cloudinary, R2).
NEXT_PUBLIC_MEDIA_URL=

# Публичный адрес фронта — для sitemap, canonical и Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
