# Скопируйте в .env: copy .env.example .env   (Windows) / cp .env.example .env
# Строки с # — необязательные, у них есть значения по умолчанию.

# ---------- Основное ----------
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Локально — SQLite. Прод — PostgreSQL: postgres://user:pass@host:5432/voltra
DATABASE_URL=sqlite:///db.sqlite3

# ---------- Фронт и CORS ----------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# CSRF_TRUSTED_ORIGINS=          # по умолчанию = CORS_ALLOWED_ORIGINS (+ домен Render)

# ---------- Почта ----------
# Локально письма печатаются в консоль; прод: smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Voltra <no-reply@voltra.kz>
EMAIL_VERIFICATION_REQUIRED=True

# ---------- Stripe (необязательно) ----------
# Без ключей онлайн-оплата выключена: заказы «картой» не принимаются, «при получении» — работают.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_CURRENCY=kzt
# STRIPE_MIN_AMOUNT=500
# STRIPE_SESSION_MINUTES=60

# ---------- Магазин ----------
FREE_SHIPPING_FROM=100000
COURIER_PRICE=1500
# ORDER_NUMBER_START=100000      # номера заказов VT-100001, VT-100002, …

# ---------- Медиа ----------
MEDIA_URL=/media/
# local — папка media/ (разработка); s3 — Cloudflare R2 / любое S3 (прод без постоянного диска)
MEDIA_STORAGE=local
# S3_BUCKET=voltra-media
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_DOMAIN=pub-xxxxxxxx.r2.dev

# ---------- Лимиты частоты (вход, регистрация, сброс пароля, промокоды) ----------
# По умолчанию при DEBUG=True — мягкие 1000/min (для e2e фронта), при DEBUG=False — строгие.
# THROTTLE_RELAXED=True
# THROTTLE_LOGIN=10/min
# THROTTLE_REGISTER=10/hour
# THROTTLE_PASSWORD_RESET=5/hour
# THROTTLE_PROMO=30/min
# Хранилище счётчиков: один процесс — locmemcache://; несколько воркеров — dbcache://django_cache
# (один раз: python manage.py createcachetable)
# CACHE_URL=locmemcache://

# ---------- Прод (за прокси Render/Railway) ----------
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
